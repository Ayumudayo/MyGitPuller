<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GitPullerSubtlePanelBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="GitPullerSubtleBorderBrush" Color="#33000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GitPullerSubtlePanelBrush" Color="#202020" />
            <SolidColorBrush x:Key="GitPullerSubtleBorderBrush" Color="#33FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="GitPullerSubtlePanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GitPullerSubtleBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="GitPullerPagePadding">16</Thickness>
    <Thickness x:Key="GitPullerCompactPadding">12</Thickness>
    <Thickness x:Key="GitPullerTightPadding">8</Thickness>
    <x:Double x:Key="GitPullerRowSpacing">8</x:Double>
    <x:Double x:Key="GitPullerColumnSpacing">16</x:Double>

    <Style x:Key="GitPullerWrappingTextBlockStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
    </Style>

    <Style x:Key="GitPullerRepositoryListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="112" />
    </Style>
</ResourceDictionary>
