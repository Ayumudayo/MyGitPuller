<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GitPuller_WinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GitPuller_WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="using:GitPuller_WinUI.Selectors"
    xmlns:vm="using:GitPuller_WinUI.ViewModels"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="FailedStatusBadgeTemplate" x:DataType="vm:RepositoryResultViewModel">
            <Border
                Padding="8,4"
                Background="{ThemeResource GitPullerPanelAltBrush}"
                BorderBrush="{ThemeResource GitPullerFailedBrush}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource GitPullerFailedBrush}"
                        Glyph="{x:Bind StatusIcon}" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GitPullerFailedBrush}"
                        Text="{x:Bind StatusText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WarningStatusBadgeTemplate" x:DataType="vm:RepositoryResultViewModel">
            <Border
                Padding="8,4"
                Background="{ThemeResource GitPullerPanelAltBrush}"
                BorderBrush="{ThemeResource GitPullerWarningBrush}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource GitPullerWarningBrush}"
                        Glyph="{x:Bind StatusIcon}" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GitPullerWarningBrush}"
                        Text="{x:Bind StatusText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="UpdatedStatusBadgeTemplate" x:DataType="vm:RepositoryResultViewModel">
            <Border
                Padding="8,4"
                Background="{ThemeResource GitPullerPanelAltBrush}"
                BorderBrush="{ThemeResource GitPullerUpdatedBrush}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource GitPullerUpdatedBrush}"
                        Glyph="{x:Bind StatusIcon}" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GitPullerUpdatedBrush}"
                        Text="{x:Bind StatusText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CleanStatusBadgeTemplate" x:DataType="vm:RepositoryResultViewModel">
            <Border
                Padding="8,4"
                Background="{ThemeResource GitPullerPanelAltBrush}"
                BorderBrush="{ThemeResource GitPullerCleanBrush}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource GitPullerCleanBrush}"
                        Glyph="{x:Bind StatusIcon}" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GitPullerCleanBrush}"
                        Text="{x:Bind StatusText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EmptyStatusBadgeTemplate">
            <Grid Width="0" Height="0" />
        </DataTemplate>

        <DataTemplate x:Key="CleanRunStatusIndicatorTemplate" x:DataType="vm:RunStatusIndicatorViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse
                    Width="9"
                    Height="9"
                    Fill="{ThemeResource GitPullerCleanBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GitPullerCleanBrush}"
                    Text="{x:Bind Text}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UpdatedRunStatusIndicatorTemplate" x:DataType="vm:RunStatusIndicatorViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse
                    Width="9"
                    Height="9"
                    Fill="{ThemeResource GitPullerUpdatedBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GitPullerUpdatedBrush}"
                    Text="{x:Bind Text}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WarningRunStatusIndicatorTemplate" x:DataType="vm:RunStatusIndicatorViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse
                    Width="9"
                    Height="9"
                    Fill="{ThemeResource GitPullerWarningBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GitPullerWarningBrush}"
                    Text="{x:Bind Text}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CanceledRunStatusIndicatorTemplate" x:DataType="vm:RunStatusIndicatorViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse
                    Width="9"
                    Height="9"
                    Fill="{ThemeResource GitPullerCanceledBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GitPullerCanceledBrush}"
                    Text="{x:Bind Text}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FailedRunStatusIndicatorTemplate" x:DataType="vm:RunStatusIndicatorViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse
                    Width="9"
                    Height="9"
                    Fill="{ThemeResource GitPullerFailedBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GitPullerFailedBrush}"
                    Text="{x:Bind Text}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RemovedRepositoryDialogItemTemplate" x:DataType="vm:RemovedRepositoryViewModel">
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Background="{ThemeResource GitPullerPanelAltBrush}"
                BorderBrush="{ThemeResource GitPullerBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Name}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Foreground="{ThemeResource GitPullerMutedTextBrush}"
                        Text="{x:Bind Category}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Text="{x:Bind RemovedPath}"
                        TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="RestoreRemovedRepositoryButton_Click"
                            Content="Restore"
                            IsEnabled="{x:Bind CanRestore}" />
                        <Button
                            Click="RestoreRemovedRepositoryAsButton_Click"
                            Content="Restore as" />
                        <Button
                            Click="OpenRemovedRepositoryFolderButton_Click"
                            Content="Open folder" />
                        <Button
                            Click="PermanentlyDeleteRemovedRepositoryButton_Click"
                            Content="Delete" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="VerticalPaneResizeHandleStyle" TargetType="controls:PaneResizeHandle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:PaneResizeHandle">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizontalPaneResizeHandleStyle" TargetType="controls:PaneResizeHandle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:PaneResizeHandle">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <selectors:RepositoryResultStatusBadgeTemplateSelector
            x:Key="RepositoryResultStatusBadgeTemplateSelector"
            CleanTemplate="{StaticResource CleanStatusBadgeTemplate}"
            EmptyTemplate="{StaticResource EmptyStatusBadgeTemplate}"
            FailedTemplate="{StaticResource FailedStatusBadgeTemplate}"
            UpdatedTemplate="{StaticResource UpdatedStatusBadgeTemplate}"
            WarningTemplate="{StaticResource WarningStatusBadgeTemplate}" />

        <selectors:RunStatusIndicatorTemplateSelector
            x:Key="RunStatusIndicatorTemplateSelector"
            CanceledTemplate="{StaticResource CanceledRunStatusIndicatorTemplate}"
            CompletedTemplate="{StaticResource UpdatedRunStatusIndicatorTemplate}"
            FailedTemplate="{StaticResource FailedRunStatusIndicatorTemplate}"
            InterruptedTemplate="{StaticResource WarningRunStatusIndicatorTemplate}"
            ReadyTemplate="{StaticResource CleanRunStatusIndicatorTemplate}"
            ReviewRequiredTemplate="{StaticResource WarningRunStatusIndicatorTemplate}"
            RunningTemplate="{StaticResource UpdatedRunStatusIndicatorTemplate}" />
    </Page.Resources>

    <Grid
        x:Name="MockupShellRoot"
        Padding="{StaticResource GitPullerShellPadding}"
        Background="{ThemeResource GitPullerAppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="SidebarColumn"
                Width="390"
                MinWidth="280"
                MaxWidth="620" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="RepositorySidebar"
            Grid.Row="0"
            Grid.Column="0"
            Background="{ThemeResource GitPullerSidebarBrush}"
            BorderBrush="{ThemeResource GitPullerBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="LibraryRootHeader"
                    Padding="18,16,18,8"
                    ColumnSpacing="6"
                    RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource GitPullerMicroLabelTextBlockStyle}"
                        Text="Library root" />
                    <Button
                        x:Name="ChangeLibraryRootButton"
                        Grid.Column="1"
                        Click="ChangeLibraryRootButton_Click"
                        IsEnabled="{Binding CanChangeLibraryRoot}"
                        Style="{StaticResource GitPullerIconButtonStyle}"
                        ToolTipService.ToolTip="Change library root">
                        <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                    </Button>
                    <Button
                        x:Name="OpenLibraryRootButton"
                        Grid.Column="2"
                        Command="{Binding OpenLibraryFolderCommand}"
                        Style="{StaticResource GitPullerIconButtonStyle}"
                        ToolTipService.ToolTip="Open library root">
                        <FontIcon FontSize="12" Glyph="&#xE838;" />
                    </Button>
                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        FontSize="13"
                        Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                        Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                        Text="{Binding LibraryRoot}" />
                </Grid>

                <TreeView
                    x:Name="FolderTreeView"
                    Grid.Row="1"
                    Margin="8,0,8,12"
                    Background="Transparent"
                    SelectionChanged="FolderTreeView_SelectionChanged"
                    SelectionMode="Single">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                MinWidth="0"
                                Padding="8,7"
                                ColumnSpacing="8"
                                ToolTipService.ToolTip="{Binding Content.AttentionText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource GitPullerFolderAccentBrush}"
                                    Glyph="{Binding Content.TreeIconGlyph}"
                                    VerticalAlignment="Top" />

                                <StackPanel Grid.Column="1" MinWidth="0" Spacing="2">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                        Text="{Binding Content.Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource GitPullerSubtleTextBrush}"
                                        Text="{Binding Content.TreeMetaText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>

                                <ContentControl
                                    Grid.Column="2"
                                    Content="{Binding Content.RepositoryResult}"
                                    ContentTemplateSelector="{StaticResource RepositoryResultStatusBadgeTemplateSelector}"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <Grid
            x:Name="MainSurface"
            Grid.Row="0"
            Grid.Column="1"
            Background="{ThemeResource GitPullerAppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition
                    x:Name="DetailsRow"
                    Height="310"
                    MinHeight="220"
                    MaxHeight="520" />
            </Grid.RowDefinitions>

            <Border
                x:Name="SyncBar"
                Grid.Row="0"
                Padding="{StaticResource GitPullerSyncBarPadding}"
                Background="{ThemeResource GitPullerPanelBrush}"
                BorderBrush="{ThemeResource GitPullerBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Style="{StaticResource GitPullerMicroLabelTextBlockStyle}"
                            Text="Last sync" />
                        <StackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="12">
                            <TextBlock
                                FontSize="14"
                                Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                Text="{Binding LastSyncCompletedText}" />
                            <ContentControl
                                Content="{Binding RunCompletionStatusIndicator}"
                                ContentTemplateSelector="{StaticResource RunStatusIndicatorTemplateSelector}"
                                FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            Command="{Binding RunSyncCommand}"
                            Style="{StaticResource GitPullerPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="13" Glyph="&#xE895;" />
                                <TextBlock Text="{Binding RunSyncButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding OpenLatestReportCommand}"
                            Style="{StaticResource GitPullerChromeButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="13" Glyph="&#xE8A5;" />
                                <TextBlock Text="Open latest report" />
                            </StackPanel>
                        </Button>
                        <Button
                            Click="AddRepositoryButton_Click"
                            Style="{StaticResource GitPullerChromeButtonStyle}">
                            <FontIcon FontSize="13" Glyph="&#xE710;" />
                        </Button>
                        <Button
                            Click="AdvancedOptionsButton_Click"
                            Style="{StaticResource GitPullerChromeButtonStyle}">
                            <FontIcon FontSize="13" Glyph="&#xE713;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                x:Name="StatusFilterBar"
                Grid.Row="1"
                Padding="18,10"
                Background="{ThemeResource GitPullerPanelBrush}"
                BorderBrush="{ThemeResource GitPullerBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="AllFilterButton_Click"
                            Content="{Binding AllFilterText}"
                            Style="{StaticResource GitPullerStatusFilterButtonStyle}" />
                        <Button
                            Click="FailedFilterButton_Click"
                            Content="{Binding FailedFilterText}"
                            Foreground="{ThemeResource GitPullerFailedBrush}"
                            Style="{StaticResource GitPullerStatusFilterButtonStyle}" />
                        <Button
                            Click="WarningFilterButton_Click"
                            Content="{Binding WarningFilterText}"
                            Foreground="{ThemeResource GitPullerWarningBrush}"
                            Style="{StaticResource GitPullerStatusFilterButtonStyle}" />
                        <Button
                            Click="UpdatedFilterButton_Click"
                            Content="{Binding UpdatedFilterText}"
                            Foreground="{ThemeResource GitPullerUpdatedBrush}"
                            Style="{StaticResource GitPullerStatusFilterButtonStyle}" />
                        <Button
                            Click="CleanFilterButton_Click"
                            Content="{Binding CleanFilterText}"
                            Foreground="{ThemeResource GitPullerCleanBrush}"
                            Style="{StaticResource GitPullerStatusFilterButtonStyle}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        Foreground="{ThemeResource GitPullerSubtleTextBrush}"
                        Text="{Binding ResultSummary}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Column="2"
                        MinWidth="220"
                        PlaceholderText="Search repositories"
                        Text="{Binding RepositorySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <Grid
                x:Name="ResultTable"
                Grid.Row="2"
                Background="{ThemeResource GitPullerPanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="16,0"
                    BorderBrush="{ThemeResource GitPullerBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="114" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Repository" />
                        <TextBlock Grid.Column="1" Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Status" />
                        <TextBlock Grid.Column="2" Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Current" />
                        <TextBlock Grid.Column="3" Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Behind" />
                        <TextBlock Grid.Column="4" Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Ahead" />
                        <TextBlock Grid.Column="5" Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Message" />
                        <TextBlock Grid.Column="6" Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Last updated" />
                    </Grid>
                </Border>

                <ListView
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource GitPullerRepositoryListViewItemStyle}"
                    ItemsSource="{Binding VisibleResults}"
                    SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RepositoryResultViewModel">
                            <Grid
                                MinHeight="46"
                                Padding="16,6"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="114" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>

                                <StackPanel MinWidth="0" Spacing="1">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource GitPullerMutedTextBrush}"
                                        Text="{x:Bind Category}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>

                                <ContentControl
                                    Grid.Column="1"
                                    Content="{Binding}"
                                    ContentTemplateSelector="{StaticResource RepositoryResultStatusBadgeTemplateSelector}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="2"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource GitPullerSubtleTextBrush}"
                                    Text="{x:Bind CurrentText}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="3"
                                    FontSize="12"
                                    Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                    Text="{x:Bind BehindText}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="4"
                                    FontSize="12"
                                    Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                    Text="{x:Bind AheadText}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="5"
                                    FontSize="12"
                                    Foreground="{ThemeResource GitPullerSubtleTextBrush}"
                                    Text="{x:Bind MessageText}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="6"
                                    FontSize="12"
                                    Foreground="{ThemeResource GitPullerSubtleTextBrush}"
                                    Text="{x:Bind LastUpdatedText}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border
                x:Name="DetailsPane"
                Grid.Row="3"
                Padding="{StaticResource GitPullerDetailsPadding}"
                Background="{ThemeResource GitPullerSidebarAltBrush}"
                BorderBrush="{ThemeResource GitPullerBorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource GitPullerFolderAccentBrush}"
                            Glyph="&#xE8A5;"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" MinWidth="0" Spacing="2">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                Text="{Binding SelectedResultName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource GitPullerSubtleTextBrush}"
                                Text="{Binding SelectedResultPath}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ContentControl
                            Grid.Column="2"
                            Content="{Binding SelectedResult}"
                            ContentTemplateSelector="{StaticResource RepositoryResultStatusBadgeTemplateSelector}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Grid
                        x:Name="DetailsSplitGrid"
                        Grid.Row="1"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                x:Name="DetailsDiagnosticsColumn"
                                Width="1.35*"
                                MinWidth="360" />
                            <ColumnDefinition
                                x:Name="DetailsRepositoryInfoColumn"
                                Width="1*"
                                MinWidth="320" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="DetailsDiagnosticsPanel"
                            Padding="14,12"
                            Background="{ThemeResource GitPullerPanelBrush}"
                            BorderBrush="{ThemeResource GitPullerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource GitPullerPanelCornerRadius}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer
                                    x:Name="DetailsDiagnosticsScroller"
                                    Grid.Row="0"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource GitPullerMicroLabelTextBlockStyle}"
                                            Text="Diagnostics" />
                                        <TextBlock
                                            Style="{StaticResource GitPullerPanelTitleTextBlockStyle}"
                                            Text="{Binding SelectedResultDiagnosticTitle}" />
                                        <TextBlock
                                            Foreground="{ThemeResource GitPullerSubtleTextBrush}"
                                            Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                            Text="{Binding SelectedResultDiagnosticExplanation}" />
                                        <Border
                                            Padding="10"
                                            Background="{ThemeResource GitPullerPanelAltBrush}"
                                            BorderBrush="{ThemeResource GitPullerBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <Grid ColumnSpacing="12" RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Retry policy" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                                    Text="{Binding SelectedResultRetryPolicyText}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Style="{StaticResource GitPullerMicroLabelTextBlockStyle}"
                                                    Text="Recommended action" />
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Spacing="4">
                                                    <TextBlock
                                                        Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                                        Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                                        Text="{Binding SelectedResultSuggestedAction}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource GitPullerSubtleTextBrush}"
                                                        Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                                        Text="{Binding SelectedResultRetryPolicyDescription}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            Style="{StaticResource GitPullerMicroLabelTextBlockStyle}"
                                            Text="Evidence" />
                                        <Border
                                            Padding="10"
                                            Background="{ThemeResource GitPullerPanelAltBrush}"
                                            BorderBrush="{ThemeResource GitPullerBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <TextBlock
                                                Style="{StaticResource GitPullerEvidenceTextBlockStyle}"
                                                Text="{Binding SelectedResultEvidence}" />
                                        </Border>
                                        <TextBlock
                                            Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                            Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                            Text="{Binding SelectedResultRelatedCommand}" />
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel
                                    x:Name="DetailsDiagnosticsActionBar"
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="PrimaryRetrySelectedDetailButton"
                                        Command="{Binding RetrySelectedCommand}"
                                        Content="{Binding SelectedResultRetryButtonText}"
                                        Style="{StaticResource GitPullerPrimaryButtonStyle}" />
                                    <Button
                                        x:Name="SecondaryRetrySelectedDetailButton"
                                        Command="{Binding RetrySelectedCommand}"
                                        Content="{Binding SelectedResultRetryButtonText}"
                                        Style="{StaticResource GitPullerChromeButtonStyle}" />
                                    <Button
                                        Command="{Binding OpenSelectedRepositoryFolderCommand}"
                                        Content="Open folder"
                                        Style="{StaticResource GitPullerChromeButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="DetailsRepositoryInfoPanel"
                            Grid.Column="1"
                            Padding="14,12"
                            Background="{ThemeResource GitPullerPanelBrush}"
                            BorderBrush="{ThemeResource GitPullerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource GitPullerPanelCornerRadius}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer
                                    x:Name="DetailsRepositoryInfoScroller"
                                    Grid.Row="0"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource GitPullerMicroLabelTextBlockStyle}"
                                            Text="Repository info" />
                                        <TextBlock Style="{StaticResource GitPullerPanelTitleTextBlockStyle}" Text="{Binding SelectedResultCategory}" />
                                        <TextBlock
                                            Foreground="{ThemeResource GitPullerSubtleTextBrush}"
                                            Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                            Text="{Binding SelectedResultRemoteUrl}" />
                                        <Grid ColumnSpacing="12" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Current" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                                Text="{Binding SelectedResultCurrentText}" />
                                            <TextBlock Grid.Row="1" Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Tracking" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                FontSize="12"
                                                Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                                Text="{Binding SelectedResultTrackingText}" />
                                            <TextBlock Grid.Row="2" Style="{StaticResource GitPullerMicroLabelTextBlockStyle}" Text="Last updated" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                FontSize="12"
                                                Foreground="{ThemeResource GitPullerPrimaryTextBrush}"
                                                Text="{Binding SelectedResultLastUpdatedText}" />
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel
                                    x:Name="DetailsRepositoryInfoActionBar"
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Command="{Binding OpenSelectedRemoteCommand}"
                                        Content="Open remote"
                                        Style="{StaticResource GitPullerChromeButtonStyle}" />
                                    <Button
                                        Click="RemovedRepositoriesButton_Click"
                                        Style="{StaticResource GitPullerChromeButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Removed" />
                                            <TextBlock Text="{Binding RemovedRepositoryCount}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <controls:PaneResizeHandle
                            x:Name="DetailsColumnResizeHandle"
                            Grid.Column="0"
                            Canvas.ZIndex="20"
                            Width="6"
                            HorizontalAlignment="Right"
                            CursorShape="SizeWestEast"
                            PointerCanceled="PaneResizeHandle_PointerReleased"
                            PointerCaptureLost="PaneResizeHandle_PointerReleased"
                            PointerMoved="PaneResizeHandle_PointerMoved"
                            PointerPressed="PaneResizeHandle_PointerPressed"
                            PointerReleased="PaneResizeHandle_PointerReleased"
                            Style="{StaticResource VerticalPaneResizeHandleStyle}"
                            Tag="DetailsColumn"
                            ToolTipService.ToolTip="Resize details panes" />
                    </Grid>
                </Grid>
            </Border>

            <controls:PaneResizeHandle
                x:Name="DetailsResizeHandle"
                Grid.Row="3"
                Canvas.ZIndex="20"
                Height="6"
                VerticalAlignment="Top"
                CursorShape="SizeNorthSouth"
                PointerCanceled="PaneResizeHandle_PointerReleased"
                PointerCaptureLost="PaneResizeHandle_PointerReleased"
                PointerMoved="PaneResizeHandle_PointerMoved"
                PointerPressed="PaneResizeHandle_PointerPressed"
                PointerReleased="PaneResizeHandle_PointerReleased"
                Style="{StaticResource HorizontalPaneResizeHandleStyle}"
                Tag="Details"
                ToolTipService.ToolTip="Resize details pane" />
        </Grid>

        <controls:PaneResizeHandle
            x:Name="SidebarResizeHandle"
            Grid.Row="0"
            Grid.Column="0"
            Canvas.ZIndex="20"
            Width="6"
            HorizontalAlignment="Right"
            CursorShape="SizeWestEast"
            PointerCanceled="PaneResizeHandle_PointerReleased"
            PointerCaptureLost="PaneResizeHandle_PointerReleased"
            PointerMoved="PaneResizeHandle_PointerMoved"
            PointerPressed="PaneResizeHandle_PointerPressed"
            PointerReleased="PaneResizeHandle_PointerReleased"
            Style="{StaticResource VerticalPaneResizeHandleStyle}"
            Tag="Sidebar"
            ToolTipService.ToolTip="Resize repository tree" />

        <Border
            x:Name="FooterStatusBar"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Padding="16,0"
            Background="{ThemeResource GitPullerSidebarAltBrush}"
            BorderBrush="{ThemeResource GitPullerBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ContentControl
                        Content="{Binding FooterRunStateIndicator}"
                        ContentTemplateSelector="{StaticResource RunStatusIndicatorTemplateSelector}"
                        FontSize="12" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource GitPullerSubtleTextBrush}"
                        Text="{Binding CurrentProgressMessage}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="14"
                    VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="{ThemeResource GitPullerSubtleTextBrush}" Text="{Binding FooterSummaryText}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource GitPullerUpdatedBrush}" Text="{Binding UpdatedFooterText}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource GitPullerCleanBrush}" Text="{Binding CleanFooterText}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource GitPullerWarningBrush}" Text="{Binding WarningFooterText}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource GitPullerFailedBrush}" Text="{Binding FailedFooterText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
