<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GitPuller_WinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GitPuller_WinUI.ViewModels"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <NavigationView
        x:Name="CategoryNavigation"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsSettingsVisible="False"
        Loaded="CategoryNavigation_Loaded"
        PaneDisplayMode="Left"
        PaneTitle="Library"
        SelectionChanged="CategoryNavigation_SelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel Padding="{StaticResource GitPullerCompactPadding}" Spacing="4">
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Library root" />
                <TextBlock
                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                    Text="{x:Bind ViewModel.LibraryRoot, Mode=OneWay}" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="AllRepositoriesItem"
                Content="All repositories"
                Tag="__all">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Dalamud plugins" Tag="Dalamud plugins">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Tooling" Tag="Tooling">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Archived experiments" Tag="Archived experiments">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.Content>
            <Grid Padding="{StaticResource GitPullerPagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="480" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    MinWidth="0"
                    RowSpacing="{StaticResource GitPullerRowSpacing}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CommandBar
                        Grid.Row="0"
                        DefaultLabelPosition="Right"
                        IsOpen="False">
                        <AppBarButton
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            Label="Run all">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Refresh" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Command="{x:Bind ViewModel.RetrySelectedCommand}"
                            Label="Retry selected">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Refresh" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Command="{x:Bind ViewModel.AddRepositoryCommand}"
                            Label="Add URL">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Add" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>

                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="{StaticResource GitPullerColumnSpacing}"
                        RowSpacing="{StaticResource GitPullerRowSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            Grid.Column="0"
                            DisplayMemberPath="Name"
                            Header="Add target category"
                            ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                            PlaceholderText="Choose category"
                            SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />

                        <TextBox
                            Grid.Column="1"
                            Header="Repository URL"
                            PlaceholderText="https://github.com/owner/repository.git"
                            Text="{x:Bind ViewModel.RepositoryUrlToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <Button
                            Grid.Column="2"
                            Margin="0,28,0,0"
                            Command="{x:Bind ViewModel.AddRepositoryCommand}"
                            Content="Add" />
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.HasAttentionItems, Mode=OneWay}"
                            Message="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}"
                            Severity="Warning"
                            Title="Run review required" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
                        <ToggleSwitch
                            AutomationProperties.Name="Clean repositories"
                            Header="Clean repositories"
                            IsOn="{x:Bind ViewModel.ShowCleanRepositories, Mode=TwoWay}"
                            OffContent="Hidden"
                            OnContent="Shown" />
                        <ProgressBar
                            Maximum="100"
                            Value="{x:Bind ViewModel.RunProgress, Mode=OneWay}" />
                    </StackPanel>

                    <ListView
                        Grid.Row="3"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource GitPullerRepositoryListViewItemStyle}"
                        ItemsSource="{x:Bind ViewModel.VisibleResults, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RepositoryResultViewModel">
                                <Grid
                                    MinWidth="0"
                                    Padding="{StaticResource GitPullerTightPadding}"
                                    ColumnSpacing="12"
                                    RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind StatusText}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                        Text="{x:Bind Name}" />
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Content="{x:Bind RetryButtonText}"
                                        IsEnabled="{x:Bind CanRetry}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                        Text="{x:Bind Summary}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                        Text="{x:Bind Path}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    Padding="{StaticResource GitPullerCompactPadding}"
                    Background="{ThemeResource GitPullerSubtlePanelBrush}"
                    BorderBrush="{ThemeResource GitPullerSubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedResultName, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />

                            <InfoBar
                                IsOpen="{x:Bind ViewModel.HasSelectedResult, Mode=OneWay}"
                                Message="{x:Bind ViewModel.SelectedResultSummary, Mode=OneWay}"
                                Severity="Informational"
                                Title="{x:Bind ViewModel.SelectedResultStatus, Mode=OneWay}" />

                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Category" />
                                <TextBlock
                                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedResultCategory, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Remote URL" />
                                <TextBlock
                                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedResultRemoteUrl, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Local path" />
                                <TextBlock
                                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedResultPath, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Diagnostic" />
                                <TextBlock
                                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedResultDiagnosticExplanation, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedResultSuggestedAction, Mode=OneWay}" />
                            </StackPanel>

                            <Expander Header="Evidence" IsExpanded="True">
                                <TextBlock
                                    Padding="{StaticResource GitPullerTightPadding}"
                                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedResultEvidence, Mode=OneWay}" />
                            </Expander>

                            <Expander Header="Related command">
                                <TextBlock
                                    Padding="{StaticResource GitPullerTightPadding}"
                                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedResultRelatedCommand, Mode=OneWay}" />
                            </Expander>

                            <Expander Header="Logs">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedResultLogLines, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander Header="Removed repositories">
                                <ListView ItemsSource="{x:Bind ViewModel.RemovedRepositories, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RemovedRepositoryViewModel">
                                            <StackPanel Padding="{StaticResource GitPullerTightPadding}" Spacing="4">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                                    Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Style="{StaticResource GitPullerWrappingTextBlockStyle}"
                                                    Text="{x:Bind OriginalPath}" />
                                                <Button
                                                    Content="{x:Bind RestoreStateText}"
                                                    IsEnabled="{x:Bind CanRestore}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Page>
