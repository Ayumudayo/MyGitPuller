<ContentDialog
    x:Class="GitPuller_WinUI.Views.Dialogs.AddRepositoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add repository"
    PrimaryButtonText="Clone"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    mc:Ignorable="d">
    <ScrollViewer
        MaxHeight="640"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
            <TextBox
                x:Name="UrlBox"
                Header="Clone URL"
                PlaceholderText="https://github.com/owner/repository.git"
                TextWrapping="Wrap" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="CategoryBox"
                    Header="Category"
                    PlaceholderText="Choose category"
                    HorizontalAlignment="Stretch" />
                <Button
                    x:Name="NewCategoryButton"
                    Grid.Column="1"
                    Content="+ New"
                    VerticalAlignment="Bottom" />
            </Grid>
            <TextBox
                x:Name="NewCategoryBox"
                PlaceholderText="New category"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <TextBox
                x:Name="FolderBox"
                PlaceholderText="Leave empty to use the repository name"
                TextWrapping="Wrap">
                <TextBox.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Folder name" />
                        <Border
                            Padding="6,1,6,2"
                            CornerRadius="8"
                            BorderThickness="1">
                            <TextBlock
                                FontSize="11"
                                Text="Optional" />
                        </Border>
                        <FontIcon
                            x:Name="FolderHelpIcon"
                            FontSize="12"
                            Glyph="&#xE946;" />
                    </StackPanel>
                </TextBox.Header>
            </TextBox>
            <TextBlock
                FontWeight="SemiBold"
                Text="Target path preview" />
            <TextBlock
                x:Name="PreviewText"
                TextWrapping="Wrap" />
            <TextBlock
                FontWeight="SemiBold"
                Text="Current library root" />
            <TextBlock
                x:Name="CurrentRootText"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="DiagnosticTitleText"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="DiagnosticExplanationText"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="DiagnosticEvidenceText"
                TextWrapping="Wrap" />
            <InfoBar
                x:Name="ErrorBar"
                Severity="Error"
                Title="Clone failed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
